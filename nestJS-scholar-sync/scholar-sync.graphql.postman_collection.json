{
    "info": {
        "name": "Scholar Sync GraphQL",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        { "key": "baseUrl", "value": "https://compunet.onrender.com" },
        { "key": "token", "value": "" }
    ],
    "item": [
        {
            "name": "login",
            "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "url": "{{baseUrl}}/graphql",
                "body": {
                    "mode": "graphql",
                    "graphql": {
                        "query": "mutation Login($input: LoginInput!) { login(input: $input) { access_token } }",
                        "variables": "{ \"input\": { \"email\": \"dave@example.com\", \"password\": \"Password123\" } }"
                    }
                }
            }
        },
        {
            "name": "users",
            "request": {
                "method": "POST",
                "header": [
                    { "key": "Content-Type", "value": "application/json" },
                    { "key": "Authorization", "value": "Bearer {{token}}" }
                ],
                "url": "{{baseUrl}}/graphql",
                "body": {
                    "mode": "graphql",
                    "graphql": { "query": "{ users { id email firstName major1 level } }", "variables": "" }
                }
            }
        },
        {
            "name": "createUser",
            "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "url": "{{baseUrl}}/graphql",
                "body": {
                    "mode": "graphql",
                    "graphql": {
                        "query": "mutation Create($input: CreateUserInput!) { createUser(input: $input) { id email } }",
                        "variables": "{ \"input\": { \"email\": \"nuevo@example.com\", \"password\": \"Password123\", \"firstName\": \"Nuevo\", \"lastName\": \"Usuario\", \"major1\": \"Software Engineering\", \"xp\": 1, \"level\": 1 } }"
                    }
                }
            }
        },
        {
            "name": "createPost",
            "request": {
                "method": "POST",
                "header": [
                    { "key": "Content-Type", "value": "application/json" },
                    { "key": "Authorization", "value": "Bearer {{token}}" }
                ],
                "url": "{{baseUrl}}/graphql",
                "body": {
                    "mode": "graphql",
                    "graphql": {
                        "query": "mutation Create($input: CreatePostInput!) { createPost(input: $input) { id title user { id } } }",
                        "variables": "{ \"input\": { \"userId\": 1, \"title\": \"Hola\", \"question\": \"Como uso GraphQL?\" } }"
                    }
                }
            }
        },
        {
            "name": "posts",
            "request": {
                "method": "POST",
                "header": [
                    { "key": "Content-Type", "value": "application/json" },
                    { "key": "Authorization", "value": "Bearer {{token}}" }
                ],
                "url": "{{baseUrl}}/graphql",
                "body": {
                    "mode": "graphql",
                    "graphql": { "query": "{ posts { id title question user { id email } replies { id replyMessage } } }", "variables": "" }
                }
            }
        },
        {
            "name": "createReply",
            "request": {
                "method": "POST",
                "header": [
                    { "key": "Content-Type", "value": "application/json" },
                    { "key": "Authorization", "value": "Bearer {{token}}" }
                ],
                "url": "{{baseUrl}}/graphql",
                "body": {
                    "mode": "graphql",
                    "graphql": {
                        "query": "mutation Create($input: CreateReplyInput!) { createReply(input: $input) { id replyMessage likes } }",
                        "variables": "{ \"input\": { \"postId\": 1, \"userId\": 1, \"replyMessage\": \"Respuesta de prueba\" } }"
                    }
                }
            }
        },
        {
            "name": "validateReply (Professor/TA)",
            "request": {
                "method": "POST",
                "header": [
                    { "key": "Content-Type", "value": "application/json" },
                    { "key": "Authorization", "value": "Bearer {{token}}" }
                ],
                "url": "{{baseUrl}}/graphql",
                "body": {
                    "mode": "graphql",
                    "graphql": {
                        "query": "mutation { validateReply(id: 1) { id isValidated approvals } }",
                        "variables": ""
                    }
                }
            }
        }
    ]
}
